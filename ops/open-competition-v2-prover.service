[Unit]
Description=Agent Bounties Open Competition V2 Beta3 CPU prover
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-bounties-prover
Group=agent-bounties-prover
SupplementaryGroups=docker
EnvironmentFile=/etc/agent-bounties/prover.env
ExecStartPre=/usr/bin/docker image inspect ghcr.io/succinctlabs/sp1-gnark:agent-bounties-sp1-safe-v5
ExecStart=/usr/bin/python3 /opt/agent-bounties/scripts/open_competition_v2_prover_service.py
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/agent-bounties-prover
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-bounties-prover
MemoryMax=120G
TasksMax=256

[Install]
WantedBy=multi-user.target
