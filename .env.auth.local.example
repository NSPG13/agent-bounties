# Local-only website authentication configuration.
# Copy to .env.auth.local; never commit the populated file.

AUTH_ORIGIN=http://127.0.0.1:4173
AUTH_SESSION_SECRET=
# Keep this stable to preserve OAuth-account-to-wallet associations across session-secret rotation.
AUTH_WALLET_LINK_SECRET=
AGENT_BOUNTIES_API_BASE_URL=https://api.agentbounties.app

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/auth/callback/google

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4173/auth/callback/microsoft

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/auth/callback/github

AMAZON_OAUTH_CLIENT_ID=
AMAZON_OAUTH_CLIENT_SECRET=
AMAZON_OAUTH_REDIRECT_URI=http://127.0.0.1:4173/auth/callback/amazon

# Optional company/workforce OIDC connection. Configure separately from public Amazon accounts.
ENTERPRISE_OIDC_ISSUER=
ENTERPRISE_OIDC_CLIENT_ID=
ENTERPRISE_OIDC_CLIENT_SECRET=
ENTERPRISE_OIDC_REDIRECT_URI=http://127.0.0.1:4173/auth/callback/enterprise
