
      let fundingEvent = null;
      if (!contractAccount) {
        if (!window.AgentBountiesX402 || typeof window.AgentBountiesX402.fund !== "function") {
          throw new Error("The gas-sponsored funding client is unavailable. Reload before authorizing USDC.");
        }
        const x402Result = await window.AgentBountiesX402.fund({
          apiBase: api,
          provider: state.provider,
          account,
          bountyContract: bounty.bounty_contract,
          amountBaseUnits: String(contribution.amount.amount),
          usdcAddress: protocol.native_usdc,
        });
        txHash = x402Result.transactionHash;
        fundingEvent = { tx_hash: txHash, source: "x402-hosted-relay" };
      } else {
        const plan = await requestJson(`${api}/v1/base/autonomous-bounties/contribution-plan`, {
          method: "POST",
          body: JSON.stringify({ network: "base-mainnet", contribution }),
        });
        const sent = await sendWalletCalls(plan.wallet_calls, account, protocol);
        if (sent.kind === "transactions") txHash = sent.hashes[sent.hashes.length - 1];
      }
"""
    replace_once(path, old, new)


def patch_check_site() -> None:
    path = ROOT / "scripts/check-site.py"
    replace_once(
        path,
        '    "onramp.css",\n',
        '    "onramp.css",\n'
        '    "wallet-adapters.css",\n'
        '    "wallet-config.js",\n'
        '    "wallet-adapter-registry.js",\n'
        '    "coinbase-embedded-wallet.bundle.js",\n'
        '    "coinbase-embedded-wallet.bundle.css",\n'
        '    "x402-browser.js",\n',
    )


def patch_check_py() -> None:
    path = ROOT / "scripts/check.py"
    replace_once(
        path,
        '        "scripts/check-site.py", "scripts/check-moonpay-onramp.py", "scripts/check-migration-history.py", "scripts/check-render-blueprint.py",\n',
        '        "scripts/check-site.py", "scripts/check-coinbase-embedded-wallet.py", "scripts/configure-wallet-providers.py",\n'
        '        "scripts/check-moonpay-onramp.py", "scripts/check-migration-history.py", "scripts/check-render-blueprint.py",\n',
    )


def patch_pages() -> None:
    path = ROOT / ".github/workflows/pages.yml"
    source = path.read_text(encoding="utf-8")
    marker = '      - "site/**"\n'
    if source.count(marker) != 2:
        raise SystemExit("pages.yml: expected site path marker twice")
    replacement = marker + (
        '      - "tools/coinbase-embedded-wallet/**"\n'
        '      - "scripts/check-coinbase-embedded-wallet.py"\n'
        '      - "scripts/configure-wallet-providers.py"\n'
        '      - "scripts/test-wallet-adapter-registry.js"\n'
        '      - "scripts/test-x402-browser.js"\n'
        '      - "docs/coinbase-embedded-wallet.md"\n'
    )
    path.write_text(source.replace(marker, replacement), encoding="utf-8")

    replace_once(
        path,
        '      - uses: actions/setup-node@v6\n        with:\n          node-version: "22"\n      - run: python scripts/check-site.py\n',
        '      - uses: actions/setup-node@v6\n'
        '        with:\n'
        '          node-version: "22"\n'
        '          cache: "npm"\n'
        '          cache-dependency-path: tools/coinbase-embedded-wallet/package-lock.json\n'
        '      - name: Install locked Coinbase wallet dependencies\n'
        '        run: npm ci --prefix tools/coinbase-embedded-wallet --ignore-scripts --no-audit --no-fund\n'
        '      - name: Prepare reviewed esbuild binary\n'
        '        run: npm rebuild --prefix tools/coinbase-embedded-wallet esbuild\n'
        '      - name: Verify generated Coinbase wallet bundle is current\n'
        '        run: |\n'
        '          cp site/coinbase-embedded-wallet.bundle.js /tmp/coinbase-wallet.js\n'
        '          cp site/coinbase-embedded-wallet.bundle.css /tmp/coinbase-wallet.css\n'
        '          npm run build --prefix tools/coinbase-embedded-wallet\n'
        '          cmp /tmp/coinbase-wallet.js site/coinbase-embedded-wallet.bundle.js\n'
        '          cmp /tmp/coinbase-wallet.css site/coinbase-embedded-wallet.bundle.css\n'
        '      - run: python scripts/check-coinbase-embedded-wallet.py\n'
        '      - run: python scripts/check-site.py\n',
    )
    replace_once(
        path,
        '          node --check site/guild-shell.js\n',
        '          node --check site/guild-shell.js\n'
        '          node --check site/wallet-adapter-registry.js\n'
        '          node --check site/x402-browser.js\n'
        '          node scripts/test-wallet-adapter-registry.js\n'
        '          node scripts/test-x402-browser.js\n',
    )
    replace_once(
        path,
        '      - uses: actions/checkout@v4\n      - uses: actions/configure-pages@v6\n',
        '      - uses: actions/checkout@v4\n'
        '      - uses: actions/setup-node@v6\n'
        '        with:\n'
        '          node-version: "22"\n'
        '          cache: "npm"\n'
        '          cache-dependency-path: tools/coinbase-embedded-wallet/package-lock.json\n'
        '      - name: Build Coinbase embedded-wallet adapter from lockfile\n'
        '        run: |\n'
        '          npm ci --prefix tools/coinbase-embedded-wallet --ignore-scripts --no-audit --no-fund\n'
        '          npm rebuild --prefix tools/coinbase-embedded-wallet esbuild\n'
        '          npm run build --prefix tools/coinbase-embedded-wallet\n'
        '      - name: Configure public wallet providers\n'
        '        env:\n'
        '          COINBASE_CDP_PROJECT_ID: ${{ vars.COINBASE_CDP_PROJECT_ID }}\n'
        '        run: python scripts/configure-wallet-providers.py\n'
        '      - run: python scripts/check-coinbase-embedded-wallet.py\n'
        '      - uses: actions/configure-pages@v6\n',
    )
    replace_once(
        path,
        '              && curl "${common_curl[@]}" "https://agentbounties.app/simple-home.js?verify=${nonce}" -o /tmp/live-simple-home.js; then\n',
        '              && curl "${common_curl[@]}" "https://agentbounties.app/simple-home.js?verify=${nonce}" -o /tmp/live-simple-home.js \\\n'
        '              && curl "${common_curl[@]}" "https://agentbounties.app/wallet-config.js?verify=${nonce}" -o /tmp/live-wallet-config.js \\\n'
        '              && curl "${common_curl[@]}" "https://agentbounties.app/coinbase-embedded-wallet.bundle.js?verify=${nonce}" -o /tmp/live-coinbase-wallet.js \\\n'
        '              && curl "${common_curl[@]}" "https://agentbounties.app/x402-browser.js?verify=${nonce}" -o /tmp/live-x402-browser.js; then\n',
    )
    replace_once(
        path,
        "                && ! grep -q 'Open Source' /tmp/live-simple-home.js; then\n",
        "                && ! grep -q 'Open Source' /tmp/live-simple-home.js \\\n"
        "                && grep -q 'coinbaseEmbedded' /tmp/live-wallet-config.js \\\n"
        "                && ! grep -q '__COINBASE_CDP_PROJECT_ID__' /tmp/live-wallet-config.js \\\n"
        "                && grep -q 'coinbase-embedded' /tmp/live-coinbase-wallet.js \\\n"
        "                && grep -q 'Link another sign-in method' /tmp/live-coinbase-wallet.js \\\n"
        "                && grep -q 'agent-bounty-fund' /tmp/live-x402-browser.js \\\n"
        "                && grep -q 'Gas is sponsored for this funding action' /tmp/live-earn.html; then\n",
    )


