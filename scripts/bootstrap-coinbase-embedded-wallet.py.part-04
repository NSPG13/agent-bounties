"""


def install_new_files() -> None:
    import base64
    import io
    import zipfile

    archive = zipfile.ZipFile(io.BytesIO(base64.b64decode(PAYLOAD_ZIP_BASE64)))
    for member in archive.infolist():
        relative = Path(member.filename)
        if relative.is_absolute() or ".." in relative.parts:
            raise SystemExit(f"unsafe embedded payload path: {member.filename}")
        destination = ROOT / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(archive.read(member))


def replace_once(path: Path, old: str, new: str) -> None:
    source = path.read_text(encoding="utf-8")
    count = source.count(old)
    if count != 1:
        raise SystemExit(f"{path}: expected marker exactly once, found {count}: {old[:100]!r}")
    path.write_text(source.replace(old, new, 1), encoding="utf-8")


def append_once(path: Path, text: str) -> None:
    source = path.read_text(encoding="utf-8")
    if text.strip() in source:
        return
    path.write_text(source.rstrip() + "\n" + text.lstrip(), encoding="utf-8")


def patch_gitignore() -> None:
    append_once(ROOT / ".gitignore", "/tools/coinbase-embedded-wallet/.build-check\n")


def patch_earn() -> None:
    path = ROOT / "site/earn.html"
    replace_once(
        path,
        '    <link rel="stylesheet" href="onramp.css?v=1">\n',
        '    <link rel="stylesheet" href="onramp.css?v=1">\n'
        '    <link rel="stylesheet" href="wallet-adapters.css?v=1">\n'
        '    <link rel="stylesheet" href="coinbase-embedded-wallet.bundle.css?v=1">\n',
    )
