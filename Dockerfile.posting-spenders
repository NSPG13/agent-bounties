# Attended cutover image for the existing two gas-spending workers only.
# syntax=docker/dockerfile:1

ARG RUST_VERSION=1.94
FROM rust:${RUST_VERSION}-bookworm AS builder

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY bounties ./bounties
COPY contracts ./contracts
COPY fixtures ./fixtures
COPY migrations ./migrations
COPY ops ./ops
COPY schemas ./schemas
COPY site ./site
COPY deployments/base-mainnet.json ./deployments/base-mainnet.json

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/workspace/target,sharing=locked \
    find crates bounties contracts fixtures migrations ops schemas site deployments -type f -exec touch {} + \
    && cargo build --locked --release -p worker \
    && cp target/release/worker /tmp/agent-bounties-service

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 app
COPY --from=builder /tmp/agent-bounties-service /usr/local/bin/agent-bounties-service

COPY scripts/run-posting-spender.sh /usr/local/bin/run-posting-spender
USER app
ENV POSTING_SENDS_PAUSED=true
ENV RUST_LOG=info
EXPOSE 8080 8090

ENTRYPOINT ["/bin/bash", "/usr/local/bin/run-posting-spender"]
